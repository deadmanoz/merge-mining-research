# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/
.python-version

# Local secrets / RPC credentials.
.env
.env.*

# Operator-specific private-infra tokens for `just check-leaks` (internal host
# aliases, personal handles). Commit only .leak-tokens.example.
.leak-tokens

# Editors
.vscode/
.idea/
.claude/
*.swp
.DS_Store

# Runtime cache (regenerated by the script)
cache/

# Pipeline scratch / runtime
data/prototype/
logs/

# AuxPoW recovery intermediate scratch (regenerated by scripts/extract_*_auxpow.py
# + scripts/classify_*_stales.py). Classifier defaults may write ignored working
# files here for convenience, but canonical storage for full classified outputs,
# raw extracts, PoW-passing intermediates, and rejection sidecars is the private
# per-chain archive, not public-repo data/. The committed canonical input for
# each completed chain is the stale-only validated CSV named after the chain's
# source tag, e.g. data/namecoin_validated_stales.csv or
# data/bitcoin-vault_validated_stales.csv.
data/*_auxpow_raw.csv
data/*_auxpow_raw.*.csv
data/*_btc_valid.csv
data/*_rejected.csv
data/*_rejected_stales.csv
data/*_stale_blocks.csv
data/*_canonical_blocks.csv
data/*_unknown_blocks.csv
data/*_near_blocks.csv

# Local-only mirror of the consolidated full canonical inventories, copied from
# the private per-chain archive for pipeline convenience. Kept out of git per the
# "largest consolidated datasets are published separately" boundary (README
# "Data"); available locally, never committed.
data/canonical/

# Full-evidence AuxPoW exports can include bulky/private classifier rows when
# built with --chain-archive-dir. Regenerate them with
# scripts/reports/build_auxpow_full_evidence.py instead of committing snapshots
# from a local archive run.
results/full-evidence/

# Regenerable analysis diagnostics depend on private full inventories and can
# be large. The namespace and its README are committed, but generated family
# subdirectories stay local or in the private chain archive.
results/analysis/*/

# Upstream public datasets fetched via scripts/fetch-data.sh
data/stale-blocks/
