# Linux target selections. Replace every placeholder in a private .env.
NAMECOIN_IMAGE=merge-mining-research/namecoind:28.0.0-native
NAMECOIN_CONTAINER_NAME=namecoind
NAMECOIN_RESTART_POLICY=no
NAMECOIN_DATA_DIR=/path/to/existing/namecoin-data
NAMECOIN_CONFIG_FILE=/path/to/existing/namecoin-data/namecoin.conf
COMPOSE_FILE=docker-compose.yml

# For the reviewed offline profile, use:
# COMPOSE_FILE=docker-compose.yml:compose.offline.yml
