default:
    @just --list

# Render and validate the selected Compose configuration without starting it.
config:
    docker compose config --quiet

# Build from the two preserved binaries in the local ignored context.
build:
    docker compose build

# Start an already created retained container.
start:
    docker compose start namecoind

# Gracefully park the retained container and preserve its datadir.
stop:
    docker compose stop --timeout -1 namecoind

status:
    docker compose ps namecoind

logs:
    docker compose logs --tail=200 namecoind

# Call the CLI with the same mounted datadir and reviewed config.
rpc METHOD *ARGS:
    docker compose exec -T namecoind namecoin-cli -datadir=/data -conf=/config/namecoin.conf "{{METHOD}}" {{ARGS}}
