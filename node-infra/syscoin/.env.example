# Linux target selections. Replace every placeholder in a private .env.
SYSCOIN_IMAGE=merge-mining-research/syscoind:5.1.0-native
SYSCOIN_CONTAINER_NAME=syscoind
SYSCOIN_RESTART_POLICY=no
SYSCOIN_DATA_DIR=/path/to/existing/syscoin-data
SYSCOIN_CONFIG_FILE=/path/to/existing/syscoin-data/syscoin.conf
COMPOSE_FILE=docker-compose.yml

# For the reviewed offline profile, use:
# COMPOSE_FILE=docker-compose.yml:compose.offline.yml
