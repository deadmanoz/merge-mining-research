# Copy to .env and adjust. `.env` is gitignored.

# Image selection (built by `just build` by default).
SOLIDAR_IMAGE=merge-mining-research/solidard:0.8.9.0-a1ab9063
SOLIDAR_CONTAINER_NAME=solidard

# Existing datadir; the bind is noncreating, so this must exist.
SOLIDAR_DATA_DIR=./data

# Host address for the RPC publish (loopback by default).
SOLIDAR_RPC_BIND=127.0.0.1

# Restart policy stays disabled until acceptance.
SOLIDAR_RESTART_POLICY=no

# Profile selection (docker compose syntax):
# Online acquisition-capable profile (default):
COMPOSE_FILE=docker-compose.yml
# Networkless offline reads of an adopted datadir:
#COMPOSE_FILE=docker-compose.yml:compose.offline.yml
