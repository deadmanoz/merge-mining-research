# Copy to private .env and replace every path before Compose use.
RSK_IMAGE=merge-mining-research/rsk:9.0.1
RSK_CONTAINER_NAME=rskj
RSK_RESTART_POLICY=no
RSK_DATA_DIR=/path/to/copied/rsk-data
RSK_RPC_BIND=127.0.0.1
RSK_RPC_PORT=4444
COMPOSE_FILE=docker-compose.yml

# For the reviewed offline profile:
# COMPOSE_FILE=docker-compose.yml:compose.offline.yml
