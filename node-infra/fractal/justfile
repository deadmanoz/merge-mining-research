set dotenv-load := true

default:
    @just --list

# Render bitcoin.conf in the datadir (FRACTAL_DATA_DIR, default ./data).
init:
    ./init.sh

# Build the fractald image (downloads the pre-built upstream tarball).
build:
    docker compose build

# Validate configuration without printing private settings.
config:
    docker compose config --quiet

# Start from the selected existing image.
up:
    docker compose up -d --no-build --pull never

start:
    docker compose start fractald

stop:
    docker compose stop --timeout -1 fractald

# Stop and remove the container (the data volume persists).
down:
    docker compose down --timeout -1

# Tail the fractald logs.
logs:
    docker compose logs -f --tail=200 fractald

# Blockchain height from inside the container.
height:
    docker compose exec -T fractald fractal-cli -datadir=/home/fractal/.fractal -conf=/home/fractal/.fractal/bitcoin.conf getblockcount

# Peer count.
peers:
    docker compose exec -T fractald fractal-cli -datadir=/home/fractal/.fractal -conf=/home/fractal/.fractal/bitcoin.conf getconnectioncount

# Full sync/peer snapshot.
status:
    @echo '--- blockchain ---'
    @docker compose exec -T fractald fractal-cli -datadir=/home/fractal/.fractal -conf=/home/fractal/.fractal/bitcoin.conf getblockchaininfo | head -30
    @echo '--- peers ---'
    @docker compose exec -T fractald fractal-cli -datadir=/home/fractal/.fractal -conf=/home/fractal/.fractal/bitcoin.conf getpeerinfo | head -40

# Drop into a shell inside the container.
shell:
    docker compose exec fractald bash

# One-line IBD status with deltas since the last check.
sync-status:
    ./sync-status.sh
