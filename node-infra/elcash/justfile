set dotenv-load := true

default:
    @just --list

# Render elcash.conf in the datadir (ELCASH_DATA_DIR, default ./data).
init:
    ./init.sh

# Build the elcashd image from the upstream source (autotools, no wallet/GUI).
build:
    docker compose build

# Start elcashd and begin IBD.
up:
    docker compose up -d

start:
    docker compose start elcashd

stop:
    docker compose stop --timeout -1 elcashd

# Stop and remove the container while preserving chain data.
down:
    docker compose down --timeout -1

# Tail daemon logs.
logs:
    docker compose logs -f --tail=200 elcashd

# Current child-chain height.
height:
    docker compose exec elcashd elcash-cli -datadir=/data -rpcport="${ELCASH_RPC_PORT:-18432}" getblockcount

# Peer count.
peers:
    docker compose exec elcashd elcash-cli -datadir=/data -rpcport="${ELCASH_RPC_PORT:-18432}" getconnectioncount

# Full sync/peer snapshot.
status:
    @echo '--- blockchain ---'
    @docker compose exec elcashd elcash-cli -datadir=/data -rpcport="${ELCASH_RPC_PORT:-18432}" getblockchaininfo | head -30
    @echo '--- peers ---'
    @docker compose exec elcashd elcash-cli -datadir=/data -rpcport="${ELCASH_RPC_PORT:-18432}" getpeerinfo | head -40
