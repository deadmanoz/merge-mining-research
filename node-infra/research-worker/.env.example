# Copy this file to .env and replace paths with the actual host paths.
# All three bind sources must already exist; Compose must not create them.
# Edit these values before running `just config` or `just build`.
MMR_REPO_DIR=/path/to/merge-mining-research
MMR_ARCHIVE_ROOT=/path/to/selected-archive
MMR_WORK_DIR=/path/to/disposable-work

# Record the checked-out revision used to build the image.
MMR_SOURCE_REVISION=<mmr-commit-or-working-tree>

# Optional image pin.
# PYTHON_IMAGE=python:3.12-slim-bookworm

# Linux only: uncomment to reach a daemon bound to host loopback. Leave this
# commented for ordinary bridge networking.
# COMPOSE_FILE=docker-compose.yml:compose.host-rpc.yml
