# The worker installs only the package from the repository build context.
# Keep private archives, credentials, Git metadata, caches and LFS payloads
# outside the context sent to Docker.
**
# These exclusions document the material that must never enter this build
# context, even if the package allowlist changes later.
.git/
.env
cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
data/
results/
docs/
!pyproject.toml
!README.md
!LICENSE
!src/
!src/**
!node-infra/
!node-infra/research-worker/
!node-infra/research-worker/Dockerfile
# Keep generated bytecode and test/tool caches out even within the package
# source allowlist.
src/**/__pycache__/
src/**/*.pyc
src/**/.pytest_cache/
src/**/.ruff_cache/
