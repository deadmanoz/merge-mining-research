# Copy to a private .env and replace every path before Compose use.
QBIT_IMAGE=merge-mining-research/qbit:1.0.0-70fea84f-archive
QBIT_CONTAINER_NAME=mmr-qbit-archive
QBIT_RESTART_POLICY=no
QBIT_DATA_DIR=/absolute/private/qbit/data
QBIT_CONFIG_FILE=/absolute/private/qbit/qbit.conf
# Host address RPC is published on: loopback for acquisition and local reads,
# the selected private host address for a remote poller (never 0.0.0.0).
QBIT_RPC_BIND=127.0.0.1
BUILD_JOBS=4
COMPOSE_FILE=docker-compose.yml

# For networkless reads of the retained datadir:
# COMPOSE_FILE=docker-compose.yml:compose.offline.yml
