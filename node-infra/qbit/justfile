set dotenv-load := true

default:
    @just --list

config:
    docker compose config --quiet

# Build from the digest-verified local source.tar; the only recipe that builds.
build:
    docker compose build qbit

# Create and start from the selected existing image; never builds or pulls.
up:
    docker compose up -d --no-build --pull never qbit

start:
    docker compose start qbit

stop:
    docker compose stop --timeout -1 qbit

# Stop and remove the container and network; the datadir and image persist.
down:
    docker compose down --timeout -1

status:
    docker compose ps qbit

logs:
    docker compose logs --tail=100 qbit

rpc +args:
    docker compose exec -T qbit qbit-cli -datadir=/data -conf=/config/qbit.conf {{args}}

test:
    docker compose config --quiet
    docker compose run --rm --no-deps qbit qbitd -version

research-build:
    docker compose --project-name qbit-research -f compose.research.yml build research-worker

research +args:
    docker compose --project-name qbit-research -f compose.research.yml run --rm --no-deps research-worker {{args}}

research-background name +args:
    docker compose --project-name qbit-research -f compose.research.yml run --detach --name {{name}} --no-deps research-worker {{args}}

# Remove only the stopped container; retain the archive and image.
clean:
    docker compose rm -f qbit
