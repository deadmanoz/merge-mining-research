# This Dockerfile is MMR-owned but its build context is the local monitor
# checkout. Keep private state and generated/build trees out of the context.
**
.git/
.env
.beads/
.tmp/
backups/
logs/
target/
node_modules/
test-results/
playwright-report/

!Cargo.toml
!Cargo.lock
!README.md
!LICENSE
!RELEASE_NOTES.md
!crates/
!crates/**
!data/
!data/consensus/
!data/consensus/error_blocks.csv
!data/historical/
!data/historical/historical-source-manifest.json
!data/pools/
!data/pools/current.json
!data/pools/child-identities/
!data/pools/child-identities/elastos_minerinfo_registry.json
!data/pools/child-identities/elastos_reward_address_registry.json
!data/pools/child-identities/fractal_reward_address_registry.json
!data/pools/child-identities/hathor_reward_registry.json
!data/pools/child-identities/namecoin_payout_address_registry.json
!data/pools/child-identities/rsk_miner_registry.json
!data/pools/child-identities/syscoin_payout_address_registry.json
!data/sources/
!data/sources/chain_profiles.json
!www/
!www/**

# Do not send generated caches that happen to occur below an allowlisted tree.
**/.env
**/*.env
**/private/
**/private/**
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/target/
