# Copy to .env and edit every value before running `just config` or `just build`.
# All bind sources must already exist; Compose must not create them.
MMM_REPO_DIR=/path/to/merge-mining-monitor
MMR_REPO_DIR=/path/to/merge-mining-research
MMM_PGDATA_DIR=/path/to/development/monitor/postgres

# Separate development credentials, never production credentials.
MMM_DB_USER=mmm_dev
MMM_DB_PASSWORD=<development-password>
MMM_DB_NAME=mmm

# Guest app port is published on host loopback only.
MMM_APP_PORT=18080

# Record the source revision used to build the image.
MMM_SOURCE_REVISION=<monitor-commit-or-working-tree>

# Optional pinned builder image and log filter.
# RUST_IMAGE=rust:1.88-bookworm
# RUST_LOG=info
