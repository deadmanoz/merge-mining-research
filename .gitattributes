# Normalize line endings: store all text as LF and check out LF everywhere.
# CSV outputs are generated by Python's csv module (which writes CRLF); this
# keeps the committed form consistent LF and reproducible across runs.
* text=auto eol=lf

# Binary assets (never normalize)
*.png binary
*.gz binary
*.db binary
*.parquet binary

# Large per-chain publication payloads live in Git LFS. The evidence writer
# emits LF directly because LFS objects bypass Git text normalization.
results/monitor-evidence/*_monitor_evidence.csv filter=lfs diff=lfs merge=lfs -text
